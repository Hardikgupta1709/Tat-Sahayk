# Application
PROJECT_NAME=Tat-Sahayk API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=5001
API_V1_PREFIX=/api/v1

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg2://tat_sahayk:tat_sahayk@localhost:5432/tat_sahayk
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Frontend origins, separated by commas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI provider:
# local  = use only the Python ML service
# azure  = use only Azure OpenAI vision and text analysis
# hybrid = use both providers
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false

# Local ML service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_SECONDS=30
ML_SERVICE_HEALTH_PATH=/health
ML_SERVICE_ANALYZE_PATH=/api/v1/analyze/report

# Phone OTP: disabled | console | acs
# Console mode is for local development only.
# Azure Communication Services cannot issue phone numbers for India.
PHONE_OTP_PROVIDER=console
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5

# Background jobs
ENABLE_SOCIAL_HARVESTER=true
ENABLE_CLUSTER_ANALYSIS=false
SOCIAL_HARVEST_INTERVAL_MINUTES=15
CLUSTER_ANALYSIS_INTERVAL_MINUTES=15

# Azure is optional. Leave AZURE_ENABLED=false to run entirely on the
# local ML service; no Azure SDK is loaded in that case.
AZURE_ENABLED=false

# Azure OpenAI. One gpt-4o-mini deployment serves both vision and text.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_VISION_DEPLOYMENT=analysis
AZURE_OPENAI_TEXT_DEPLOYMENT=analysis

# Azure Blob Storage for report media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=report-media

# Azure Communication Services: alert email and OTP SMS.
# A managed azurecomm.net sender domain is capped at 10 emails per hour.
ACS_CONNECTION_STRING=
ACS_SENDER_EMAIL=
ACS_SMS_FROM=
ACS_EMAIL_RECIPIENTS_PER_MESSAGE=50
ACS_EMAIL_MAX_MESSAGES_PER_ALERT=2

# Azure AI Video Indexer. Bills per input minute, and requires
# MEDIA_STORAGE_PROVIDER=azure_blob because it fetches videos by URL.
AZURE_VIDEO_INDEXER_ENABLED=false
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_LOCATION=
AZURE_VIDEO_INDEXER_API_KEY=
AZURE_VIDEO_INDEXER_TIMEOUT_SECONDS=300
# An HTTP 400 on submit means the preset name is wrong for your account;
# the accepted values are listed in the Video Indexer developer portal.
AZURE_VIDEO_INDEXER_INDEXING_PRESET=VideoOnly
AZURE_VIDEO_INDEXER_STREAMING_PRESET=NoStreaming

# Google OAuth
GOOGLE_CLIENT_ID=

# External verification services
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# Media storage: local | azure_blob
MEDIA_STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=uploads
LOCAL_MEDIA_URL=/uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
