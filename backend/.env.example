# Application
PROJECT_NAME=Tat-Sahayk API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=5001
API_V1_PREFIX=/api/v1

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg2://tat_sahayk:tat_sahayk@localhost:5432/tat_sahayk
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_CREATE_TABLES=true

# Frontend origins, separated by commas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI provider:
# local   = use only the Python ML service
# bedrock = use only AWS Bedrock/Rekognition
# hybrid  = use both providers
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false

# Local ML service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_SECONDS=30
ML_SERVICE_HEALTH_PATH=/health
ML_SERVICE_ANALYZE_PATH=/api/v1/analyze/report

# Background jobs
ENABLE_SOCIAL_HARVESTER=false
ENABLE_CLUSTER_ANALYSIS=false
SOCIAL_HARVEST_INTERVAL_MINUTES=15
CLUSTER_ANALYSIS_INTERVAL_MINUTES=15

# AWS is optional
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_BEDROCK_TEXT_MODEL_ID=us.amazon.nova-micro-v1:0
SES_SOURCE_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=

# External verification services
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# Legacy Cloudinary settings
# These are retained temporarily for backward compatibility.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=