# Docker Compose project
COMPOSE_PROJECT_NAME=tat-sahayk-prototype

# PostgreSQL/PostGIS
POSTGRES_DB=tat_sahayk
POSTGRES_USER=tat_sahayk
POSTGRES_PASSWORD=tat_sahayk_local_password
POSTGRES_PORT=5432

# Exposed service ports
FRONTEND_PORT=8080
BACKEND_PORT=5001
ML_SERVICE_PORT=8000

# Generate a stronger value with:
# openssl rand -hex 32
SECRET_KEY=local-development-secret-change-before-deployment

# AI provider: local | azure | hybrid
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false

# Phone OTP: disabled | console | acs
# Console mode returns the code only to the authenticated development user.
PHONE_OTP_PROVIDER=console
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5

# Optional external APIs
OPENWEATHER_API_KEY=
STORMGLASS_API_KEY=
TAVILY_API_KEY=

# Optional Azure configuration.
# Leave AZURE_ENABLED=false to run entirely on the local ML service.
AZURE_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_VISION_DEPLOYMENT=analysis
AZURE_OPENAI_TEXT_DEPLOYMENT=analysis
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=report-media
ACS_CONNECTION_STRING=
ACS_SENDER_EMAIL=
ACS_SMS_FROM=
GOOGLE_CLIENT_ID=

# Media storage: local | azure_blob
MEDIA_STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=uploads
LOCAL_MEDIA_URL=/uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
