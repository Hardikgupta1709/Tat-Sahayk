# Compose deployment identity
COMPOSE_PROJECT_NAME=tat-sahayk-production

# Only the frontend is exposed publicly, and only to the host TLS proxy.
# Keep FRONTEND_BIND_HOST at 127.0.0.1 on an internet-facing host so the app
# is unreachable over plain HTTP on the public IP. Use 0.0.0.0 only for local
# testing or behind an external load balancer.
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8080

# PostgreSQL
POSTGRES_DB=tat_sahayk
POSTGRES_USER=tat_sahayk
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# Keep the password URL-encoded if it contains reserved URL characters.
DATABASE_URL=postgresql+psycopg2://tat_sahayk:replace-with-a-strong-url-safe-password@db:5432/tat_sahayk
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API directly.
# Same-origin requests through Nginx do not require CORS.
CORS_ORIGINS=https://your-domain.example

# AI provider: local | azure | hybrid
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false
ML_SERVICE_TIMEOUT_SECONDS=30

# Phone OTP: disabled | acs
# Console delivery is deliberately rejected in production.
# Azure Communication Services cannot issue phone numbers for India, so
# acs delivery only reaches numbers in ACS-supported countries.
PHONE_OTP_PROVIDER=disabled
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5

# Media storage: local | azure_blob
MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif

# Optional background analysis
ENABLE_SOCIAL_HARVESTER=true
ENABLE_CLUSTER_ANALYSIS=false
SOCIAL_HARVEST_INTERVAL_MINUTES=15
CLUSTER_ANALYSIS_INTERVAL_MINUTES=15

# Google OAuth web client
GOOGLE_CLIENT_ID=

# Azure is required only for the AI, media, email and SMS features.
# Leave AZURE_ENABLED=false to run entirely on the local ML service.
AZURE_ENABLED=false

# Azure OpenAI. One gpt-4o-mini deployment serves both vision and text;
# the two deployment settings may name the same deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_VISION_DEPLOYMENT=analysis
AZURE_OPENAI_TEXT_DEPLOYMENT=analysis

# Azure Blob Storage for report media.
# The account and the container both need anonymous blob read enabled
# before the browser can render an uploaded image from its direct URL.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=report-media

# Azure Communication Services: alert email and OTP SMS.
# An Azure-managed azurecomm.net sender domain is capped at 5 emails per
# minute and 10 per hour, and that cap cannot be raised. Alert recipients
# are therefore batched into a small number of bcc messages.
ACS_CONNECTION_STRING=
ACS_SENDER_EMAIL=
ACS_SMS_FROM=
ACS_EMAIL_RECIPIENTS_PER_MESSAGE=50
ACS_EMAIL_MAX_MESSAGES_PER_ALERT=2

# Azure AI Video Indexer bills per input minute and needs a standard ARM
# account (the free trial account has no API access). It also fetches the
# video by public URL, so MEDIA_STORAGE_PROVIDER must be azure_blob.
AZURE_VIDEO_INDEXER_ENABLED=false
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_LOCATION=
AZURE_VIDEO_INDEXER_API_KEY=
AZURE_VIDEO_INDEXER_TIMEOUT_SECONDS=300
# VideoOnly skips audio transcription, which is billed separately. If a
# submit returns HTTP 400, the preset name is wrong for your account —
# check the accepted values in the Video Indexer developer portal.
AZURE_VIDEO_INDEXER_INDEXING_PRESET=VideoOnly
AZURE_VIDEO_INDEXER_STREAMING_PRESET=NoStreaming

# Optional external services
OPENWEATHER_API_KEY=
STORMGLASS_API_KEY=
TAVILY_API_KEY=
